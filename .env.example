# VLM Control — variáveis de ambiente (copie para .env.local)
#
# Sem estas variáveis o app roda em MODO LOCAL: os dados ficam apenas no
# IndexedDB deste navegador, sem login real e sem sincronização com a nuvem.
#
# URL do projeto Supabase (Project Settings → API → Project URL)
VITE_SUPABASE_URL=
# Chave pública "anon" (Project Settings → API → anon public).
# NUNCA coloque a service_role key em variáveis VITE_*: elas vão para o navegador.
VITE_SUPABASE_ANON_KEY=

# Opcional — Cursos e materiais do Google Drive (veja docs/CURSOS.md).
# ID do cliente OAuth do tipo "Aplicativo da Web" (termina em .apps.googleusercontent.com). É PÚBLICO por natureza;
# o app usa só o escopo drive.metadata.readonly, sem client secret. NUNCA coloque client secret, refresh token ou
# chave de conta de serviço aqui. Sem esta variável, o ID pode ser informado na própria tela (fica neste navegador).
VITE_GOOGLE_CLIENT_ID=
